# ==============================================================================
# Six9Chat - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' and populate with your actual credentials.
# NEVER commit '.env.local' or real API keys to version control.
# ==============================================================================

# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server / Admin Role Key (Optional - server-side only, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication Providers (Optional / Future expansion)
# NEXT_PUBLIC_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
